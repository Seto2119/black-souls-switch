prefix=/c/Users/user/black-souls-switch/portlibs
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: ruby-3.1
Description: Ruby 3.1.7 (MRI/CRuby) static library for Nintendo Switch (aarch64-none-elf)
Version: 3.1.7
Libs: -L${libdir} -lruby-static -lnxcompat -lm
Libs.private: -liconv -lcharset -lz
Cflags: -I${includedir}/ruby-3.1.0 -I${includedir}/ruby-3.1.0/aarch64-elf
