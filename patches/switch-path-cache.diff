+#ifdef __SWITCH__
+/* Handlers may copy this structure for streaming. Close the owned native
+ * RWops, but never free the stack/copy containing these forwarding callbacks. */
+static SDL_RWops nxNativeReadOps(SDL_RWops *native) {
+  SDL_RWops ops = {};
+  ops.hidden.unknown.data1 = native;
+  ops.size = [](SDL_RWops *o) -> Sint64 {
+    return SDL_RWsize(static_cast<SDL_RWops *>(o->hidden.unknown.data1));
+  };
+  ops.seek = [](SDL_RWops *o, Sint64 offset, int whence) -> Sint64 {
+    return SDL_RWseek(static_cast<SDL_RWops *>(o->hidden.unknown.data1), offset, whence);
+  };
+  ops.read = [](SDL_RWops *o, void *dst, size_t size, size_t count) -> size_t {
+    return SDL_RWread(static_cast<SDL_RWops *>(o->hidden.unknown.data1), dst, size, count);
+  };
+  ops.close = [](SDL_RWops *o) -> int {
+    return SDL_RWclose(static_cast<SDL_RWops *>(o->hidden.unknown.data1));
+  };
+  ops.type = SDL_RWOPS_UNKNOWN;
+  return ops;
+}
+#endif
