+/* The music stream asks for its own preferred core (2). It is not a luxury:
+ * this thread only has to refill buffers on time, and if it shares a core with
+ * whoever is decoding a PNG it arrives late. Before the OV_HOLE fix that
+ * lateness cost the whole soundtrack; now it would only cost a click, but no
+ * click is better than one. svcSetThreadCoreMask() takes
+ * (preferred_core, affinity_mask) and the mask is a u32 bitfield. */
+static void nxBindMusicThread() {
+    Result rc = svcSetThreadCoreMask(threadGetCurHandle(), 2, 1u << 2);
+    if (R_FAILED(rc))
+        svcSetThreadCoreMask(threadGetCurHandle(), -1, 0x7u); /* any core */
+}
+#endif
